<!-- The shader translator as an Android library (libdmsh_xlate_rt.so, NativeAOT): the Vulkan backend translates, on a worker thread, a shader the bundle lacks
     (gfx_vk_shader_rt.c, DM_VK_RUNTIME_SHADERS). It compiles dm/gfx/tools/dmsh_xlate/Program.cs unchanged, so a shader comes out as the porter's translator makes it,
     and Runtime.cs does per shader what dm/android/tools/shader_vk.py does around that translator. Built by the porter (porter/pipeline.py build_runtime_translator)
     for profiles with runtime_shaders on; -p:RyuSrc=<dir> points it at another copy of the Ryujinx source, as dmsh_xlate.csproj. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>dmsh_xlate_rt</AssemblyName>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../third_party/ryujinx</RyuSrc>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>
  <!-- -p:DmshRtNative=true (the porter): the Android shared library. Without it, a .NET library for tests on the build machine (devtools/xlate_rt_check.py) -->
  <PropertyGroup Condition="'$(DmshRtNative)' == 'true'">
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <RuntimeIdentifier>linux-bionic-arm64</RuntimeIdentifier>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <!-- NativeAOT does not support building for another OS; the porter links with the NDK's clang (CppCompilerAndLinker, SysRoot), which makes the Android library on any host -->
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <!-- Program.cs adds ints to JsonArrays (res "fetch1d"), which takes their type information from the default options: without reflection those throw -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);IL2026;IL3050;CS0436</NoWarn>
    <DefineConstants>$(DefineConstants);DMSH_RT_NATIVE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../gfx/tools/dmsh_xlate/Program.cs" Link="Program.cs" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
</Project>
